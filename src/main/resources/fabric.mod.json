{
	"schemaVersion": 1,
	"id": "flexbar-link",
	"version": "${version}",
	"name": "flexbar-link",
	"description": "Controll your item bar from your ENIAC FlexBar.",
	"authors": [
		"Sam Apostel"
	],
	"contact": {
		"homepage": "https://mc-flexbar-link.sams.land",
		"sources": "https://github.com/Sam-Apostel/mc-flexbar-link"
	},
	"license": "CC0-1.0",
	"icon": "assets/flexbar-link/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"apostel.flexbarlink.Flexbarlink"
		],
		"client": [
			"apostel.flexbarlink.FlexbarlinkClient"
		]
	},
	"mixins": [
		"flexbar-link.mixins.json",
		{
			"config": "flexbar-link.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.5",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}